<input type="hidden" id="istorikoEmployeeId" value="<%= ergazomenoiData._id %>">

<%
    const rows = Array.isArray(istorikoData) ? istorikoData : [];
    const historyAccessMode = typeof employeeHistoryAccessMode === 'string'
        ? employeeHistoryAccessMode
        : (typeof canManageEmployeeHistory !== 'undefined' && canManageEmployeeHistory ? 'ADMIN_FULL' : 'NONE');
    const canManageAnyHistory = historyAccessMode === 'ADMIN_FULL';
    const canWithdraw = historyAccessMode !== 'READ_ONLY' && typeof canWithdrawEmployeeHistory !== 'undefined' && canWithdrawEmployeeHistory;
    const showHistoryActions = canManageAnyHistory || canWithdraw;
    const currentRelationshipOpen = Boolean(ergazomenoiData?.hmeromhnia_proslhpshs) &&
        !ergazomenoiData?.hmeromhnia_apoxorhshs;
    const currentHireDate = ergazomenoiData?.hmeromhnia_proslhpshs
        ? new Date(ergazomenoiData.hmeromhnia_proslhpshs).toISOString().split('T')[0] : '';

    const fmtDate = (v) => {
        if (!v) return '';
        const d = new Date(v);
        if (Number.isNaN(d.getTime())) return '';
        return d.toLocaleDateString('el-GR', { day: '2-digit', month: '2-digit', year: 'numeric' });
    };

    const summaryDate = (row, prev, field) => {
        const value = fmtDate(row[field]);
        const repeated = Boolean(value && prev && value === fmtDate(prev[field]));
        return { text: value ? (repeated ? `↳ ${value}` : value) : '—',
            muted: !value || repeated,
            description: !value ? 'Δεν υπάρχει καταχωρισμένη τιμή'
                : repeated ? 'Ίδια τιμή με την προηγούμενη εγγραφή' : '' };
    };

    const escapeDataAttrJson = (obj) => JSON.stringify(obj || {})
        .replace(/&/g, '&amp;')
        .replace(/'/g, '&#39;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

    const originalForRow = (row) => ({
        aa_eggrafhs: row.aa_eggrafhs || '',
        hmeromhnia_proslhpshs: row.hmeromhnia_proslhpshs || '',
        hmeromhnia_allaghs_symbashs: row.hmeromhnia_allaghs_symbashs || '',
        hmeromhnia_allaghs_orarioy_apo: row.hmeromhnia_allaghs_orarioy_apo || '',
        hmeromhnia_allaghs_orarioy_eos: row.hmeromhnia_allaghs_orarioy_eos || '',
        hmeromhnia_lhxhs_symbashs: row.hmeromhnia_lhxhs_symbashs || '',
        hmeromhnia_apoxorhshs: row.hmeromhnia_apoxorhshs || ''
    });
%>

<div class="istoriko-card card d-flex flex-column z-depth-5">

    <div class="card-header p-0 istoriko-card-header">
        <label class="text-center w-100 headers-content mt-1 istoriko-card-title">
            Ιστορικό Προσλήψεων - Αλλαγών
        </label>
    </div>

    <div id="employeeHistoryReconstructionSuccess" class="alert alert-success py-2 px-3 mx-3 mt-2 mb-0 small" role="status" hidden></div>

    <div class="px-3 py-2 border-bottom d-flex flex-wrap align-items-center gap-2">
        <a id="employeeHistoryExportXlsxBtn" class="btn btn-brown rounded-4 text-wrap mw-100"
            href="/api/ergazomenoi/<%= encodeURIComponent(String(ergazomenoiData._id)) %>/history-proposal.xlsx">
            Εξαγωγή πρότασης Ιστορικού σε XLSX
        </a>
        <span class="small text-muted text-break">Προστατευμένο αρχείο από το αποθηκευμένο Ιστορικό. Η εξαγωγή δεν αποθηκεύει αλλαγές. Δεν υποστηρίζεται ακόμη εισαγωγή.</span>
    </div>

    <% if (historyAccessMode === 'READ_ONLY') { %>
    <div class="alert alert-info mx-3 mt-2 mb-0 text-break" role="status" data-history-status="LEGACY_REVIEW_REQUIRED">
        Το παλαιό Ιστορικό χρειάζεται τεκμηριωμένο έλεγχο και προβάλλεται μόνο για ανάγνωση.
        Οι εγγραφές διατηρούνται. Μπορείτε να αποθηκεύετε ανεξάρτητα στοιχεία του εργαζομένου.
        1. Διατηρήστε τις καταχωρισμένες περιόδους και τα τεκμήρια.
        2. Ζητήστε έλεγχο από διαχειριστή πριν από ιστορική μεταβολή. Δεν έγινε ιστορική αλλαγή.
        Κωδικός αναφοράς: LEGACY_REVIEW_REQUIRED.
    </div>
    <% } else { %>
    <div class="employee-history-preview-controls p-3 border-bottom">
        <button type="button" id="employeeHistoryReconstructionPreviewBtn" class="btn btn-brown rounded-4">
            Έλεγχος &amp; Αυτόματη Τακτοποίηση
        </button>
        <p class="text-muted small mb-0 mt-2">Έλεγχος όλων των περιόδων και απλή πρόταση τακτοποίησης.
            Η προεπισκόπηση δεν αποθηκεύει αλλαγές.</p>
    </div>

    <% } %>
    <% if (canManageAnyHistory) { %>
    <% const imported = ergazomenoiData.employment_import_provenance; %>
    <% if (imported && imported.status === 'VERIFIED') { %>
    <div class="px-3 py-2 text-break" id="employeeImportSummary" role="status">
        <strong>Επαληθευμένη μεταφορά από προηγούμενη εφαρμογή</strong>
        <p class="mb-1">Πραγματική πρόσληψη: <%= fmtDate(imported.hireDate) %>.
            Έναρξη παρακολούθησης: <%= fmtDate(imported.trackingStartDate) %>.
            Πρώτη καταγεγραμμένη περίοδος όρων: <%= fmtDate(rows.filter(row => row.hmeromhnia_isxyos_oron_ergasias_apo).map(row => row.hmeromhnia_isxyos_oron_ergasias_apo).sort((a,b) => new Date(a)-new Date(b))[0]) || 'Δεν υπάρχει' %>.</p>
        <p class="mb-0">Η μεταφορά δεν πιστοποιεί τους προγενέστερους όρους. Για παλαιότερους υπολογισμούς απαιτούνται τεκμηριωμένα στοιχεία.</p>
    </div>
    <% } else if (!imported) { %>
    <details class="px-3 py-2 employee-import-declaration">
        <summary>Μεταφορά από προηγούμενη εφαρμογή</summary>
        <p class="mt-2">Δηλώστε την πραγματική ημερομηνία έναρξης παρακολούθησης στο Payroll-NodeJs. Η πρόσληψη και οι ιστορικές εγγραφές διατηρούνται. Θα ακολουθήσει χωριστή επιβεβαίωση διαχειριστή.</p>
        <div class="employee-import-fields">
            <div><label for="employeeImportTrackingStart" class="form-label">Έναρξη παρακολούθησης</label>
                <input type="date" id="employeeImportTrackingStart" class="form-control"></div>
            <div class="employee-import-actions"><button type="button" id="employeeImportPreviewBtn" class="btn btn-brown rounded-4 text-wrap">Έλεγχος δήλωσης μεταφοράς</button></div>
        </div>
    </details>
    <% } %>
    <p class="small px-3 mb-2" id="employeeHistoryGuidedHelp">1. Πάτησε «Έλεγχος / Διόρθωση» στην εγγραφή που είναι λάθος. Ακολούθησε ένα βήμα κάθε φορά.</p>
    <% } %>
    <% if (historyAccessMode === 'ADMIN_FULL') { %>
        <div class="px-3 mb-2">
            <button type="button" id="employeeHistoryCorrectionStartBtn" class="btn btn-brown rounded-4">
                Διόρθωση Ιστορικού βήμα προς βήμα
            </button>
        </div>
    <% } %>

    <div class="istoriko-table-wrapper">

        <table class="table table-striped table-bordered table-sm table-hover mb-0 istoriko-table" id="istorikoTable"
            data-expected-state-token="<%= typeof employeeHistoryStateToken === 'string' ? employeeHistoryStateToken : '' %>"
            data-can-manage-history="<%= historyAccessMode === 'ADMIN_FULL' ? 'true' : 'false' %>"
            data-can-withdraw-history="<%= typeof canWithdrawEmployeeHistory !== 'undefined' && canWithdrawEmployeeHistory ? 'true' : 'false' %>"
            data-history-access-mode="<%= historyAccessMode %>"
            data-current-relationship-open="<%= currentRelationshipOpen ? 'true' : 'false' %>"
            data-current-hire-date="<%= currentHireDate %>">

            <colgroup>
                <col class="istoriko-col-aa">
                <col class="istoriko-col-date">
                <col class="istoriko-col-date-wide">
                <col class="istoriko-col-date-wide">
                <col class="istoriko-col-date-wide">
                <col class="istoriko-col-date-wide">
                <col class="istoriko-col-date">
                <col class="istoriko-col-state">
                <% if (showHistoryActions) { %><col class="istoriko-col-actions"><% } %>
            </colgroup>

            <thead>
                <tr>
                    <th class="istoriko-th istoriko-aa-col"></th>
                    <th class="istoriko-th text-center" colspan="6">Η Μ Ε Ρ Ο Μ Η Ν Ι Α</th>
                    <th class="istoriko-th istoriko-state-col"></th>
                    <% if (showHistoryActions) { %><th class="istoriko-th istoriko-actions-col"></th><% } %>
                </tr>

                <tr>
                    <th class="istoriko-th istoriko-aa-col text-center">Α/Α</th>
                    <th class="istoriko-th text-center">Πρόσληψης</th>
                    <th class="istoriko-th text-center">Αλλαγής Σύμβασης</th>
                    <th class="istoriko-th text-center istoriko-work-terms-heading">Ισχύς Όρων Εργασίας ΑΠΟ</th>
                    <th class="istoriko-th text-center istoriko-work-terms-heading">Ισχύς Όρων Εργασίας ΕΩΣ</th>
                    <th class="istoriko-th text-center">Λήξης Σύμβασης</th>
                    <th class="istoriko-th text-center">Αποχώρησης</th>
                    <th class="istoriko-th text-center istoriko-state-col">Κατ.</th>
                    <% if (showHistoryActions) { %><th class="istoriko-th istoriko-actions-col text-center">Ενέργειες</th><% } %>
                </tr>
            </thead>

            <tbody>
                <% if (rows.length > 0) { %>
                    <% rows.forEach((row, index) => { 
                        const prev = index > 0 ? rows[index - 1] : null;
                        const inactive = ['REDUNDANT_REFERENCED', 'WITHDRAWN_ERRONEOUS'].includes(row.employment_history_canonical_status);
                        const canManageRow = canManageAnyHistory && !inactive;
                    %>
                        <% if (inactive) { %><tr class="table-secondary"><td colspan="<%= showHistoryActions ? 9 : 8 %>" class="text-start text-wrap">Ιστορικά διατηρημένη — εκτός ενεργού Ιστορικού</td></tr><% } %>
                        <tr
                            class="istoriko-row<%= inactive ? ' table-secondary' : '' %>"
                            data-id="<%= row._id %>"
                            data-state="clean"
                            data-persisted="true"
                            data-can-manage-row="<%= canManageRow ? 'true' : 'false' %>"
                            data-record='<%- escapeDataAttrJson(row) %>'
                            data-original='<%- escapeDataAttrJson(originalForRow(row)) %>'>

                            <td class="text-center istoriko-aa-col"><%= String(index + 1).padStart(4, '0') %></td>
                            <% for (const field of ['hmeromhnia_proslhpshs', 'hmeromhnia_allaghs_symbashs',
                                'hmeromhnia_isxyos_oron_ergasias_apo', 'hmeromhnia_isxyos_oron_ergasias_eos',
                                'hmeromhnia_lhxhs_symbashs', 'hmeromhnia_apoxorhshs']) {
                                const date = summaryDate(row, prev, field); %>
                                <td class="text-center"><span class="istoriko-summary-date<%= date.muted ? ' text-muted' : '' %>"
                                    title="<%= date.description %>" aria-label="<%= date.description ? `${date.text}, ${date.description}` : date.text %>"><%= date.text %></span></td>
                            <% } %>

                            <td class="text-center istoriko-state-col">
                                <span class="istoriko-state state-clean"></span>
                            </td>

                            <% if (showHistoryActions) { %>
                            <td class="istoriko-actions-col text-center">
                                <div class="istoriko-actions">
                                    <% if (canManageRow) { %>
                                    <button type="button" class="btn btn-sm istoriko-btn istoriko-btn-add" data-action="add" data-id="<%= row._id %>" title="Προσθήκη" <%- canManageRow ? '' : 'disabled aria-disabled="true"' %>>
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm istoriko-btn istoriko-btn-edit" data-action="edit" data-id="<%= row._id %>" title="Τροποποίηση" <%- canManageRow ? '' : 'disabled aria-disabled="true"' %>>
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <button type="button" class="btn btn-sm employee-history-correction-action employee-history-correction-confirm" data-action="review" data-id="<%= row._id %>" title="Έλεγχος / Διόρθωση" aria-label="Έλεγχος / Διόρθωση" <%- canManageRow || (typeof canWithdrawEmployeeHistory !== 'undefined' && canWithdrawEmployeeHistory) ? '' : 'disabled aria-disabled="true"' %>>Έλεγχος / Διόρθωση</button>
                                    <button type="button" class="btn btn-sm istoriko-btn istoriko-btn-delete" data-action="delete" data-id="<%= row._id %>" title="Διαγραφή" <%- canManageRow ? '' : 'disabled aria-disabled="true"' %>>
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm istoriko-btn istoriko-btn-undo" data-action="undo" data-id="<%= row._id %>" title="Αναίρεση" <%- canManageRow ? '' : 'disabled aria-disabled="true"' %>>
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>

                                    <% } %>
                                    <% if (!inactive && !canManageAnyHistory && canWithdraw) { %>
                                    <button type="button" class="btn btn-sm employee-history-correction-action" data-action="review" data-id="<%= row._id %>">Έλεγχος αποχώρησης</button>
                                    <% } %>
                                </div>
                            </td>
                            <% } %>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="<%= showHistoryActions ? 9 : 8 %>" class="text-center text-muted istoriko-empty-row">
                            Δεν υπάρχουν εγγραφές ιστορικού.
                        </td>
                    </tr>
                <% } %>
            </tbody>

        </table>

    </div>

    <div class="card-footer mt-auto istoriko-card-footer">
        <% if (currentRelationshipOpen) { %>
            <div class="text-muted small mb-2">
                Η πρόσληψη εμφανίζεται μόνο για ανάγνωση. Για νέα εργασιακή σχέση καταχωρήστε πρώτα
                Αποχώρηση και μετά χρησιμοποιήστε την Επαναπρόσληψη.
            </div>
        <% } %>
        <div class="d-flex istoriko-footer-actions">
            <% if (canManageAnyHistory) { %>
            <button
                type="button"
                id="updateIstorikoBtn"
                class="btn rounded-4 istoriko-footer-btn istoriko-footer-btn-save"
                data-bs-toggle="tooltip"
                data-bs-title="Αποθήκευση και τακτοποίηση των εγγραφών του Ιστορικού"
                data-bs-placement="bottom"
                <%- canManageAnyHistory ? '' : 'disabled aria-disabled="true"' %>>
                <i class="bi bi-save"></i>
                Ενημέρωση Ιστορικού Αρχείου
            </button>

            <button
                type="button"
                id="cancelIstorikoBtn"
                class="btn rounded-4 istoriko-footer-btn istoriko-footer-btn-cancel"
                data-bs-toggle="tooltip"
                data-bs-title="Ακύρωση ενημέρωσης των τροποποιημένων / διεγραμμένων εγγραφών"
                data-bs-placement="bottom">
                <i class="bi bi-arrow-counterclockwise"></i>
                Ακύρωση Ενημέρωσης
            </button>

            <% } %>
            <button
                type="button"
                id="btnErganhHistory"
                class="btn rounded-4 istoriko-footer-btn istoriko-footer-btn-erganh"
                data-bs-toggle="tooltip"
                data-bs-title="Εμφάνιση του ιστορικού εγγράφων ΕΡΓΑΝΗ που σχετίζονται με τον εργαζόμενο"
                data-bs-placement="bottom">
                <i class="bi bi-clock-history"></i>
                Ιστορικό ΕΡΓΑΝΗ
            </button>

            <button
                type="button"
                id="btnErganhDashboard"
                class="btn rounded-4 istoriko-footer-btn istoriko-footer-btn-erganh"
                data-bs-toggle="tooltip"
                data-bs-title="Dashboard Υποβολών ΕΡΓΑΝΗ Εταιρείας"
                data-bs-placement="bottom">
                <i class="bi bi-bar-chart"></i>
                Dashboard ΕΡΓΑΝΗ
            </button>
        </div>
    </div>

</div>

<div class="modal fade" id="istorikoDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content istoriko-details-modal">
            <div class="modal-header istoriko-details-modal-header">
                <h5 class="modal-title">Αναλυτικά Στοιχεία Ιστορικού</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Κλείσιμο"></button>
            </div>
            <div class="modal-body">
                <div id="istorikoDetailsBody"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-brown rounded-4" data-bs-dismiss="modal">
                    Κλείσιμο
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade employee-history-preview" id="employeeHistoryReconstructionPreviewModal"
    tabindex="-1" aria-labelledby="employeeHistoryReconstructionPreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content istoriko-details-modal">
            <div class="modal-header istoriko-details-modal-header">
                <h5 class="modal-title" id="employeeHistoryReconstructionPreviewTitle">Έλεγχος &amp; Προτεινόμενη Τακτοποίηση Ιστορικού</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Κλείσιμο"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Δεν έχει αποθηκευτεί καμία αλλαγή.
                    Η εφαρμογή ελέγχει το Ιστορικό και εμφανίζει τις προτεινόμενες αλλαγές.</p>
                <div id="employeeHistoryReconstructionPreviewBody" aria-live="polite"></div>
            </div>
            <div class="modal-footer">
                <div class="employee-maintenance-choice w-100" id="employeeHistoryReconstructionApproval" hidden>
                    <input class="form-check-input" type="checkbox" id="employeeHistoryReconstructionApprovalAccepted">
                    <label class="form-check-label" for="employeeHistoryReconstructionApprovalAccepted">Έλεγξα τις προτεινόμενες αλλαγές και εγκρίνω την τακτοποίηση του Ιστορικού.</label>
                </div>
                <button type="button" class="btn btn-success rounded-4" id="employeeHistoryReconstructionApplyBtn" disabled hidden>Εφαρμογή Τακτοποίησης</button>
                <button type="button" class="btn btn-brown rounded-4" data-bs-dismiss="modal">Κλείσιμο</button>
            </div>
        </div>
    </div>
</div>

<%- include('automaticSettlementPreview') %>
