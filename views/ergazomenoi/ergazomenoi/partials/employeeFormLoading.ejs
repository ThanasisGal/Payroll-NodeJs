<style nonce="<%= nonce %>">
    [data-employee-form-state] { position: relative; }
    [data-employee-form-state]:not([data-employee-form-state="ready"]) {
        block-size: max(10rem, calc(100dvh - var(--app-header-h, 5rem) - 6rem));
        overflow: clip;
    }
    [data-employee-form-state]:not([data-employee-form-state="ready"]) > .tadded-container,
    [data-employee-form-state]:not([data-employee-form-state="ready"]) > .tadded-container * {
        visibility: hidden !important;
    }
    [data-employee-form-loading-panel] {
        position: absolute; inset: 0; display: grid; place-content: center; justify-items: center;
        gap: .85rem; padding: clamp(.75rem, 2cqi, 1.5rem); text-align: center;
        font-size: clamp(.9rem, .85rem + .2cqi, 1.05rem); color: #24496b;
        background: linear-gradient(145deg, #f8fbff, #fff); border-radius: .75rem;
    }
    [data-employee-form-loading-message] { margin: 0; max-inline-size: 36rem; }
    [data-employee-form-spinner] {
        inline-size: 2.4rem; block-size: 2.4rem; border: .22rem solid #dce8f3;
        border-top-color: #2478b8; border-radius: 50%; animation: employee-form-spin .85s linear infinite;
    }
    [data-employee-form-state="failed"] > [data-employee-form-loading-panel] { overflow: auto; align-content: start; }
    [data-employee-form-state="failed"] [data-employee-form-spinner] { display: none; }
    [data-employee-form-loading-actions] { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; }
    @keyframes employee-form-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { [data-employee-form-spinner] { animation: none; } }
    [data-employee-form-state="ready"] > [data-employee-form-loading-panel],
    [data-employee-form-loading-panel][hidden], [data-employee-form-retry][hidden], [data-employee-form-back][hidden] { display: none !important; }
    [data-employee-form-loading-message] { white-space: pre-line; overflow-wrap: anywhere; }
</style>
<div data-employee-form-loading-panel role="status" aria-live="polite">
    <span data-employee-form-spinner aria-hidden="true"></span>
    <p data-employee-form-loading-message>Προετοιμασία στοιχείων εργαζομένου…<br>Η φόρμα θα εμφανιστεί μόλις είναι έτοιμη.</p>
    <div data-employee-form-loading-actions>
        <button type="button" class="btn btn-outline-primary" data-employee-form-retry hidden>Επανάληψη φόρτωσης</button>
        <a href="/ergazomenoi/ergazomenoi" class="btn btn-outline-secondary" data-employee-form-back hidden>Επιστροφή στους εργαζομένους</a>
    </div>
</div>
    <noscript>Η φόρμα χρειάζεται JavaScript. Δεν αποθηκεύτηκε καμία αλλαγή. 1. Ενεργοποιήστε τη JavaScript. 2. Επαναφορτώστε τη σελίδα.</noscript>
<script nonce="<%= nonce %>">
(() => {
    'use strict';
    const page = document.querySelector('[data-employee-form-state="loading"]');
    if (!page || window.EmployeeFormReadiness) return;
    const panel = page.querySelector('[data-employee-form-loading-panel]');
    const pending = new Set(), finalizers = [];
    const startedAt = performance.now(), completed = new Map();
    let domReady = false, checking = false, finalizing = false, phase = 'document';
    let failureDiagnostics = null, visibleAt = null, readyAt = null;
    const renderAbort = new AbortController();
    // Sample the first visible rendering frame from navigation start, including
    // frames painted while deferred/module scripts are still initializing.
    const measureVisibility = () => {
        const content = page.querySelector('.tadded-container');
        if (content?.getClientRects().length && getComputedStyle(content).visibility === 'visible') {
            visibleAt = Math.round(performance.now());
        } else requestAnimationFrame(measureVisibility);
    };
    const ready = () => page.dataset.employeeFormState === 'ready';
    // Visibility never depends on asynchronous data. Editing stays inert until
    // required hydration completes, preventing user values from being overwritten.
    const saveButtons = new Map();
    const lockSave = () => page.querySelectorAll('.submitButton').forEach(button => {
        if (!saveButtons.has(button)) saveButtons.set(button, button.disabled);
        button.disabled = true;
    });
    page.addEventListener('click', event => {
        if (!ready() && event.target.closest('.submitButton')) {
            event.preventDefault(); event.stopImmediatePropagation();
        }
    }, true);
    page.addEventListener('submit', event => {
        if (!ready()) { event.preventDefault(); event.stopImmediatePropagation(); }
    }, true);
    // Only static task identifiers and numeric timing/status data. Never include
    // exception messages/stacks, request URLs, responses or selected field values.
    const safeName = name => /^(?:initial-(?:schedule|tax-scale|contract-elements)|schedule-(?:holidays|date-range|stored)|(?:selected-value|schedule-category):[a-zA-Z0-9_-]{1,100})$/.test(name) ? name : 'initialization';
    const diagnostics = () => failureDiagnostics || ({
        elapsedMs: Math.round(performance.now() - startedAt), visibleMs: visibleAt, readyMs: readyAt, domReady, phase,
        documentState: document.readyState, visibility: document.visibilityState,
        pending: [...pending].map(task => ({ task: task.name, elapsedMs: Math.round(performance.now() - task.startedAt) })),
        completed: [...completed].map(([task, result]) => ({ task, ...result })),
        scheduleInitialized: Boolean(page.dataset.employeeScheduleInitialized),
        scheduleRows: page.querySelectorAll('#dynamicFields .input-date').length,
        missingControls: [...page.querySelectorAll('select.tom-dropdown[data-api]')].filter(select => !select.tomselect).map(select => safeName('selected-value:' + select.id))
    });
    const taskLabel = name => name === 'initial-tax-scale' ? 'η περιγραφή της φορολογικής κλίμακας'
        : name === 'initial-contract-elements' ? 'τα αποθηκευμένα στοιχεία σύμβασης'
        : name.startsWith('selected-value:') ? 'οι επιλεγμένες τιμές των καταλόγων'
        : name === 'schedule-holidays' ? 'οι αργίες του ωραρίου'
        : name.startsWith('schedule-category:') ? 'οι κατηγορίες εργασίας του ωραρίου'
        : name === 'schedule-date-range' ? 'οι ημέρες του ωραρίου'
        : name === 'schedule-stored' ? 'το αποθηκευμένο ωράριο'
        : name === 'initial-schedule' ? 'το ωράριο εργασίας' : 'τα απαραίτητα στοιχεία της σελίδας';
    let resolveDom;
    const afterDom = new Promise(resolve => { resolveDom = resolve; });
    const loading = () => page.dataset.employeeFormState === 'loading';
    const fail = (error, task = '', reason = 'initialization-failed') => {
        if (!loading()) return;
        failureDiagnostics = { ...diagnostics(), reason, failedTask: safeName(task),
            httpStatus: Number.isInteger(error?.status) && error.status >= 100 && error.status <= 599 ? error.status : null };
        console.error('EMPLOYEE_FORM_INITIALIZATION_FAILED', failureDiagnostics);
        const tasks = task ? [task] : [...pending].map(item => item.name);
        const detail = [...new Set(tasks.map(taskLabel))].join(', ') || 'η τελική προετοιμασία της φόρμας';
        const explanation = reason === 'deadline-exceeded'
            ? 'Ξεπεράστηκε ο χρόνος αναμονής των 20 δευτερολέπτων. Εκκρεμούν: '
            : 'Δεν ήταν δυνατή η προετοιμασία: ';
        page.dataset.employeeFormState = 'failed';
        renderAbort.abort();
        lockSave();
        page.setAttribute('aria-busy', 'false');
        panel.setAttribute('role', 'alert');
        panel.querySelector('[data-employee-form-loading-message]').textContent =
            'Δεν ολοκληρώθηκε η φόρτωση των στοιχείων εργαζομένου. ' + explanation + detail + '. Η φόρμα δεν εμφανίστηκε και η αποθήκευση παραμένει αποκλεισμένη για να μη χαθούν στοιχεία.\n\n' +
            'Δεν αποθηκεύτηκε καμία αλλαγή.\n\n1. Πατήστε «Επανάληψη φόρτωσης».\n2. Αν το πρόβλημα παραμένει, επικοινωνήστε με την υποστήριξη.\n\n' +
            'Κωδικός αναφοράς: EMPLOYEE_FORM_INITIALIZATION_FAILED';
        panel.querySelector('[data-employee-form-retry]').hidden = false;
        panel.querySelector('[data-employee-form-back]')?.removeAttribute('hidden');
    };
    const verifyControls = () => {
        if (typeof window.initAllTomSelects !== 'function') throw new Error('Dropdown initializer unavailable');
        for (const select of page.querySelectorAll('select.tom-dropdown[data-api]')) {
            if (!select.tomselect) throw new Error('Dropdown unavailable: ' + select.id);
        }
        if (!page.dataset.employeeScheduleInitialized) throw new Error('Schedule initializer unavailable');
    };
    // Hidden documents may never receive an animation frame. Keep data/control
    // validation independent of painting, including visibility changes mid-wait.
    const waitForRender = () => new Promise(resolve => {
        if (renderAbort.signal.aborted || document.visibilityState !== 'visible') { resolve(); return; }
        let frame, settled = false;
        const finish = () => {
            if (settled) return;
            settled = true;
            if (frame !== undefined) cancelAnimationFrame(frame);
            document.removeEventListener('visibilitychange', onVisibilityChange);
            renderAbort.signal.removeEventListener('abort', finish);
            resolve();
        };
        const onVisibilityChange = () => {
            if (document.visibilityState !== 'visible') finish();
        };
        document.addEventListener('visibilitychange', onVisibilityChange);
        renderAbort.signal.addEventListener('abort', finish, { once: true });
        frame = requestAnimationFrame(finish);
        onVisibilityChange();
    });
    const check = async () => {
        if (!loading() || !domReady || pending.size || checking) return;
        checking = true;
        try {
            // Complete queued layout work before enabling editing and saving.
            phase = 'render';
            await waitForRender();
            if (!loading() || pending.size) return;
            if (!finalizing) {
                finalizing = true;
                phase = 'finalizers';
                for (const finalize of finalizers) finalize();
            }
            phase = 'controls';
            verifyControls();
            phase = 'render';
            await waitForRender();
            if (!loading() || pending.size) return;
            phase = 'ready';
            readyAt = Math.round(performance.now());
            page.dataset.employeeFormState = 'ready';
            page.dataset.employeeFormVisible = 'true';
            page.setAttribute('aria-busy', 'false');
            page.querySelector('.tadded-container').inert = false;
            panel.hidden = true;
            for (const [button, disabled] of saveButtons) button.disabled = disabled;
            requestAnimationFrame(measureVisibility);
            page.dispatchEvent(new CustomEvent('employeeform:ready', { bubbles: true }));
        } catch (error) { fail(error); }
        finally { checking = false; if (loading() && !pending.size) queueMicrotask(check); }
    };
    const track = (name, promise) => {
        if (!loading()) return promise;
        const token = { name: safeName(name), startedAt: performance.now() };
        pending.add(token);
        Promise.resolve(promise).then(result => {
            pending.delete(token);
            const previous = completed.get(token.name);
            completed.set(token.name, { count: (previous?.count || 0) + 1,
                elapsedMs: Math.round(performance.now() - token.startedAt),
                httpStatus: Number.isInteger(result?.status) ? result.status : null });
            check();
        }, error => fail(error, token.name));
        return promise;
    };
    window.EmployeeFormReadiness = { afterDom, track, fail, loading, ready, diagnostics,
        get FORM_VISIBLE() { return page.dataset.employeeFormVisible === 'true'; },
        get FORM_READY() { return ready(); },
        beforeReveal: callback => finalizers.push(callback) };
    panel.querySelector('[data-employee-form-retry]').addEventListener('click', event => {
        event.currentTarget.disabled = true;
        window.location.reload();
    });
    const criticalScript = /(?:initTomDropdown|dropdown-item|(?:geo|efka|profTraining)DropdownChain|symbaseisDropdownChain3|date_sync_(?:add|edit)|getDaysFromDate|selectRepo|autoLoadTaxScale|editStoixeiaSymbaseon|getFieldValues|putFieldValues|employeeDraftSave|employmentProfileUi|formLayout|sectionsVisible)\.js(?:[?:]|$)/;
    window.addEventListener('error', event => {
        const source = event.target?.src || event.filename || '';
        const inlineModule = event.target?.tagName === 'SCRIPT' && !event.target.src &&
            event.target.type === 'module' && page.contains(event.target);
        if (criticalScript.test(source) || inlineModule) {
            fail(null, '', 'script-failed');
        }
    }, true);
    window.addEventListener('unhandledrejection', event => {
        if (criticalScript.test(event.reason?.stack || '')) fail(event.reason);
    });
    // A failure deadline, not a delay before showing the form. It also bounds
    // stalled scripts/network requests which never settle their promises.
    AbortSignal.timeout(20000).addEventListener('abort', () => fail(null, '', 'deadline-exceeded'), { once: true });
    document.addEventListener('DOMContentLoaded', () => queueMicrotask(() => {
        domReady = true;
        lockSave();
        phase = 'tasks';
        resolveDom();
        check();
    }), { once: true });
})();
</script>
