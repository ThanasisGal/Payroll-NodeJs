<%
    const dateInputValue = (v) => {
        if (!v) return '';
        const d = new Date(v);
        if (isNaN(d.getTime())) return '';
        return d.toISOString().slice(0, 10);
    };
    const normalizedUserRole = String(userRole || '').trim().toUpperCase();
    const canRecordRepoTransferDecision = ['A', 'S', 'HR'].includes(normalizedUserRole);
    const canManageReusablePolicyApproval = ['A', 'S', 'HR'].includes(normalizedUserRole);
    const canApplyRepoTransferDecision = ['A', 'S', 'HR'].includes(normalizedUserRole);
    const canUseAdvancedEmploymentReview = ['A', 'S', 'HR'].includes(normalizedUserRole);
    const companyInUse = companyId || '';
%>

<div class="container-fluid mt-3 employment-review-page-shell">
    <meta name="csrf-token" content="<%= csrfToken %>" />

    <% if (canRecordRepoTransferDecision) { %>
    <div id="employmentPeriodControlPanel" class="alert alert-light border d-none" aria-live="polite">
        <div class="employment-period-control-layout d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="employment-period-control-summary">
                <span class="fw-semibold">Κατάσταση:</span>
                <span id="employmentPeriodControlStatus">Απαιτείται έλεγχος</span>
                <span class="mx-2">·</span>
                <span class="fw-semibold">Προθεσμία:</span>
                <span id="employmentPeriodControlDeadline">-</span>
                <span id="employmentPeriodDeadlineState" class="d-none"></span>
                <span id="employmentHistoricalReconstructionMeta" class="d-none">
                    <span class="mx-2">·</span><span class="fw-semibold">Ανακατασκευή:</span>
                    <span id="employmentHistoricalReconstructionStatus"></span>
                </span>
                <span id="employmentPeriodFinalizedMeta" class="d-none">
                    <span class="mx-2">·</span><span class="fw-semibold">Ημερομηνία οριστικοποίησης:</span>
                    <span id="employmentPeriodFinalizedAt"></span>
                </span>
                <span id="employmentPeriodSubmissionMeta" class="d-none">
                    <span class="mx-2">·</span><span class="fw-semibold">Υποβολή:</span>
                    <span id="employmentPeriodSubmission"></span>
                </span>
                <span id="employmentPeriodProtocolMeta" class="d-none">
                    <span class="mx-2">·</span><span class="fw-semibold">Πρωτόκολλο:</span>
                    <span id="employmentPeriodProtocol"></span>
                </span>
            </div>
            <div id="employmentPeriodControlActions" class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm d-none employment-review-action-btn employment-review-action-danger" id="lockEmploymentPeriodBtn">Κλείδωμα περιόδου</button>
                <button type="button" class="btn btn-sm d-none employment-review-action-btn employment-review-action-warning" id="historicalReconstructionBtn">Ανακατασκευή Εκπρόθεσμης Περιόδου</button>
                <button type="button" class="btn btn-sm d-none employment-review-action-btn employment-review-action-warning" id="unlockEmploymentPeriodBtn">Ξεκλείδωμα περιόδου</button>
                <button type="button" class="btn btn-sm d-none employment-review-action-btn employment-review-action-success" id="finalizeEmploymentPeriodBtn">Οριστικοποίηση περιόδου</button>
                <button type="button" class="btn btn-sm d-none employment-review-action-btn employment-review-action-success" id="submitFinalWTODayilyABtn">Τελική υποβολή Απολογιστικού Πίνακα στο ΕΡΓΑΝΗ</button>
                <button type="button" class="btn btn-sm d-none employment-review-action-btn employment-review-action-primary" id="openCorrectivePayrollBtn">Άνοιγμα διορθωτικής μισθοδοσίας</button>
                <button type="button" class="btn btn-sm d-none employment-review-action-btn employment-review-action-primary" id="calculateCorrectivePayrollBtn">Καταχώρηση διορθωτικών στοιχείων και υπολογισμός</button>
                <button type="button" class="btn btn-sm d-none employment-review-action-btn employment-review-action-secondary" id="closeCorrectivePayrollBtn">Κλείσιμο διορθωτικής μισθοδοσίας</button>
                <button type="button" class="btn btn-sm d-none employment-review-action-btn employment-review-action-success" id="postCorrectivePayrollBtn">Καταχώριση διορθωτικής μισθοδοσίας</button>
            </div>
        </div>
        <div id="employmentPeriodControlMessage" class="small text-muted mt-1"></div>
        <div id="employmentPeriodCorrectiveLegend" class="small mt-1 d-none">
            <span class="fw-semibold">Αρχικό οριστικοποιημένο αποτέλεσμα</span>
            <span class="mx-2">·</span>
            <span>Διορθωτική διαφορά</span>
            <span class="mx-2">·</span>
            <span>Διορθωμένο αποτέλεσμα</span>
        </div>
        <div id="employmentPeriodCorrectiveSummary" class="small mt-2 d-none"></div>
    </div>
    <% } else { %>
        <div class="alert alert-warning text-center" role="alert">
            Δεν έχετε δικαίωμα χρήσης του ελέγχου απασχολήσεων.
        </div>
    <% } %>

    <% if (canUseAdvancedEmploymentReview) { %>
    <section id="employmentReviewWorkspace" class="employment-review-workspace">
    <div class="card shadow-sm rounded-4 employment-review-card z-depth-5">
        <div class="card-header text-center">
            <h3 class="mb-0">Έλεγχος Απασχολήσεων</h3>
        </div>

        <div class="card-body review-card-body">
            <div class="review-filters-sticky">
                <div class="row g-1 mb-2" id="reviewFiltersEnterScope">
                    <div class="col-md-2">
                        <label class="form-label">Από Ημερομηνία</label>
                        <input
                            type="date"
                            id="apo_hmeromhnia"
                            class="form-control date-tall move-by-enter"
                            value="<%= dateInputValue(periodRec?.apo) %>"
                        />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Έως Ημερομηνία</label>
                        <input
                            type="date"
                            id="eos_hmeromhnia"
                            class="form-control date-tall move-by-enter"
                            value="<%= dateInputValue(periodRec?.eos) %>"
                        />
                    </div>

                    <div class="col-md-4 employment-review-advanced-branch">
                        <label class="form-label" for="ypokatasthma">Παράρτημα</label>
                        <input
                            type="hidden"
                            id="ypokatasthma_stathera_advanced"
                            value=""
                            readonly
                        />
                        <select
                            id="ypokatasthma"
                            class="tom-dropdown selectpicker-dropdown-normal left-align move-by-enter"
                            aria-label="Παράρτημα"
                            data-api="/api/dropdown/erganh/ypokatasthmata?company=<%= companyInUse || '' %>"
                            data-target-input="ypokatasthma_stathera_advanced"
                            data-preselect="ypokatasthma_stathera_advanced"
                            data-dropdown-direction="down"
                            data-preload-all="true"
                            data-pad-length="4"
                            data-xrhsh-related="false"
                            data-team-related="false"
                            data-company-related="false"
                            data-mhnas-related="false"
                            data-skip-autoload="true"
                            single
                            placeholder="Επιλέξτε παράρτημα">
                        </select>
                        <div id="advancedBranchValidation" class="invalid-feedback d-block d-none">
                            Επιλέξτε συγκεκριμένο παράρτημα.
                        </div>
                    </div>

                    <div class="col-md-4 employment-review-advanced-branch">
                        <label class="form-label" for="reviewEmployee">Εργαζόμενος</label>
                        <input type="hidden" id="kodikos" value="" />
                        <select id="reviewEmployee"
                            class="tom-dropdown selectpicker-dropdown-normal left-align move-by-enter"
                            aria-label="Εργαζόμενος"
                            data-api="/api/dropdown/kinhseis/apasxolhseis/ergazomenoi"
                            data-target-input="kodikos"
                            data-preselect="kodikos"
                            data-dropdown-direction="down"
                            data-xrhsh-related="false"
                            data-team-related="false"
                            data-company-related="false"
                            data-mhnas-related="false"
                            data-skip-autoload="true"
                            single
                            placeholder="Αναζήτηση εργαζομένου">
                        </select>
                    </div>
                </div>

                <div class="employment-review-search-actions">
                    <button type="button" class="btn btn-brown rounded-4" id="searchBtn">
                        <i class="bi bi-search"></i>
                        Αναζήτηση
                    </button>

                    <button type="button" class="btn btn-brown rounded-4 ms-2" id="exportExcelBtn">
                        <i class="bi bi-file-earmark-excel"></i>
                        Εξαγωγή Excel
                    </button>

                    <button type="button" class="btn btn-brown rounded-4 ms-2" id="exportPdfBtn">
                        <i class="bi bi-file-earmark-pdf"></i>
                        Εξαγωγή PDF
                    </button>
                </div>
            </div>

            <div class="employment-review-scroll-container">
                <div id="weeklyHrStage1Container" class="employment-review-actionable-summary"></div>
                <div id="policyPreviewGroupsContainer" class="employment-review-actionable-summary"></div>

                <div class="table-responsive results-table-wrapper">
                    <table class="table table-bordered table-hover align-middle" id="resultsTable">
                    <colgroup class="employment-review-results-columns">
                        <col class="review-col-date" />
                        <col class="review-col-branch" />
                        <col class="review-col-code" />
                        <col class="review-col-declared" />
                        <col class="review-col-cards" />
                        <col class="review-col-apologistiko" />
                        <col class="review-col-hours" />
                        <col class="review-col-absences" />
                        <col class="review-col-night" />
                        <col class="review-col-holiday" />
                        <col class="review-col-additional" />
                        <col class="review-col-overwork" />
                        <col class="review-col-overtime" />
                    </colgroup>
                    <thead class="table-dark">
                        <tr>
                            <th>Ημ/νία</th>
                            <th>Παράρτημα</th>
                            <th>Κωδικός</th>
                            <!-- <th>Εργαζόμενος</th> -->
                            <th>Προδηλωμένο</th>
                            <th>Κάρτες</th>
                            <th>Απολογιστικό</th>
                            <th>Ώρες</th>
                            <th>Απουσίες</th>
                            <th>Νύχτα</th>
                            <th>Αργία</th>
                            <th>Πρόσθ.</th>
                            <th>Υπερεργ.</th>
                            <th>Υπερωρ.</th>
                        </tr>
                    </thead>

                    <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card-footer">
            <a class="btn btn-secondary rounded-4 employment-review-return-btn" href="/mainapp">
                <i class="bi bi-chevron-double-left"></i>
                Επιστροφή
            </a>
        </div>
    </div>

    <div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="modal-title mb-0">Λεπτομέρειες Απασχόλησης</h5>
                        <span id="detailsLockBadge" class="review-lock-badge d-none">
                            🔒 ΚΛΕΙΔΩΜΕΝΟ
                        </span>
                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                    ></button>
                </div>

                <div class="modal-body">
                    <div id="detailsContainer"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn employment-review-action-btn employment-review-action-secondary" data-bs-dismiss="modal">
                        Κλείσιμο
                    </button>
                </div>
            </div>
        </div>
    </div>



    <div class="modal fade" id="pdfPreviewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Προεπισκόπηση PDF</h5>
                    <div class="d-flex gap-2">

                        <button
                            type="button"
                            class="btn btn-brown rounded-4"
                            id="reviewPdfDownloadBtn"
                            data-no-loader="true">
                            <i class="bi bi-download"></i>
                            Αποθήκευση τοπικά
                        </button>

                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body p-0">
                    <iframe id="reviewPdfFrame" title="Προεπισκόπηση PDF" style="width:100%;height:calc(100vh - 70px);border:0;"></iframe>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="canonicalDecisionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Απόφαση εβδομαδιαίου ελέγχου</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Κλείσιμο"></button>
                </div>
                <div class="modal-body" id="canonicalDecisionContainer">
                    <div class="text-muted">Φόρτωση τρέχουσας κατάστασης…</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn employment-review-action-btn employment-review-action-secondary" data-bs-dismiss="modal">Κλείσιμο</button>
                </div>
            </div>
        </div>
    </div>
    </section>
    <% } %>
    <input
        type="hidden"
        id="canReviewEdit"
        value="<%= ['A', 'S', 'HR'].includes(normalizedUserRole) ? '1' : '0' %>"
    />
    <input
        type="hidden"
        id="canRecordRepoTransferDecision"
        value="<%= canRecordRepoTransferDecision ? '1' : '0' %>"
    />
    <input
        type="hidden"
        id="canManageReusablePolicyApproval"
        value="<%= canManageReusablePolicyApproval ? '1' : '0' %>"
    />
    <input
        type="hidden"
        id="canApplyRepoTransferDecision"
        value="<%= canApplyRepoTransferDecision ? '1' : '0' %>"
    />
    <input
        type="hidden"
        id="canUseAdvancedEmploymentReview"
        value="<%= canUseAdvancedEmploymentReview ? '1' : '0' %>"
    />

    <% if (canRecordRepoTransferDecision) { %>
        <script type="module" src="<%= script('ergazomenoi/programmata/initYpokatasthmataDropdowns.js') %>"></script>
    <% } %>
    <script src="<%= script('ergazomenoi/programmata/elegxosApasxolhseonPeriodoy') %>"></script>
</div>
