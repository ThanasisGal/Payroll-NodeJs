<%
    const dateInputValue = (v) => {
        if (!v) return '';
        const d = new Date(v);
        if (isNaN(d.getTime())) return '';
        return d.toISOString().slice(0, 10);
    };
    const normalizedUserRole = String(userRole || '').trim().toUpperCase();
    const canRecordRepoTransferDecision = ['A', 'S', 'HR'].includes(normalizedUserRole);
    const canManageReusablePolicyApproval = ['A', 'S', 'HR'].includes(normalizedUserRole);
    const canApplyRepoTransferDecision = ['A', 'S', 'HR'].includes(normalizedUserRole);
    const canUseAdvancedEmploymentReview = ['A', 'S', 'HR'].includes(normalizedUserRole);
    const companyInUse = companyId || '';
%>

<div class="container-fluid mt-3 employment-review-page-shell">
    <meta name="csrf-token" content="<%= csrfToken %>" />

    <% if (canRecordRepoTransferDecision) { %>
    <div id="employmentPeriodControlPanel" class="alert alert-light border d-none" aria-live="polite">
        <div class="employment-period-control-layout d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="employment-period-control-summary">
                <span class="fw-semibold">Κατάσταση:</span>
                <span id="employmentPeriodControlStatus">Απαιτείται έλεγχος</span>
                <span class="mx-2">·</span>
                <span class="fw-semibold">Προθεσμία:</span>
                <span id="employmentPeriodControlDeadline">-</span>
                <span id="employmentPeriodDeadlineState" class="d-none"></span>
                <span id="employmentHistoricalReconstructionMeta" class="d-none">
                    <span class="mx-2">·</span><span class="fw-semibold">Ανακατασκευή:</span>
                    <span id="employmentHistoricalReconstructionStatus"></span>
                </span>
                <span id="employmentPeriodFinalizedMeta" class="d-none">
                    <span class="mx-2">·</span><span class="fw-semibold">Ημερομηνία οριστικοποίησης:</span>
                    <span id="employmentPeriodFinalizedAt"></span>
                </span>
                <span id="employmentPeriodSubmissionMeta" class="d-none">
                    <span class="mx-2">·</span><span class="fw-semibold">Υποβολή:</span>
                    <span id="employmentPeriodSubmission"></span>
                </span>
                <span id="employmentPeriodProtocolMeta" class="d-none">
                    <span class="mx-2">·</span><span class="fw-semibold">Πρωτόκολλο:</span>
                    <span id="employmentPeriodProtocol"></span>
                </span>
            </div>
            <div id="employmentPeriodControlActions" class="dropdown d-flex flex-wrap gap-2 d-none">
                <button type="button" id="employmentPeriodActionsDropdown"
                    class="btn btn-sm dropdown-toggle employment-review-action-btn employment-review-action-secondary"
                    data-bs-toggle="dropdown" aria-expanded="false">
                    Ενέργειες περιόδου
                </button>
                <div class="dropdown-menu dropdown-menu-end employment-period-actions-menu"
                    aria-labelledby="employmentPeriodActionsDropdown">
                    <button type="button" class="dropdown-item d-none employment-review-action-btn employment-review-action-danger" data-employment-period-action id="lockEmploymentPeriodBtn">Κλείδωμα περιόδου</button>
                    <button type="button" class="dropdown-item d-none employment-review-action-btn employment-review-action-warning" data-employment-period-action id="historicalReconstructionBtn">Ανακατασκευή Εκπρόθεσμης Περιόδου</button>
                    <button type="button" class="dropdown-item d-none employment-review-action-btn employment-review-action-warning" data-employment-period-action id="unlockEmploymentPeriodBtn">Ξεκλείδωμα περιόδου</button>
                    <button type="button" class="dropdown-item d-none employment-review-action-btn employment-review-action-success" data-employment-period-action id="finalizeEmploymentPeriodBtn">Οριστικοποίηση περιόδου</button>
                    <button type="button" class="dropdown-item d-none employment-review-action-btn employment-review-action-success" data-employment-period-action id="submitFinalWTODayilyABtn">Τελική υποβολή Απολογιστικού Πίνακα στο ΕΡΓΑΝΗ</button>
                    <button type="button" class="dropdown-item d-none employment-review-action-btn employment-review-action-primary" data-employment-period-action id="openCorrectivePayrollBtn">Άνοιγμα διορθωτικής μισθοδοσίας</button>
                    <button type="button" class="dropdown-item d-none employment-review-action-btn employment-review-action-primary" data-employment-period-action id="calculateCorrectivePayrollBtn">Καταχώρηση διορθωτικών στοιχείων και υπολογισμός</button>
                    <button type="button" class="dropdown-item d-none employment-review-action-btn employment-review-action-secondary" data-employment-period-action id="closeCorrectivePayrollBtn">Κλείσιμο διορθωτικής μισθοδοσίας</button>
                    <button type="button" class="dropdown-item d-none employment-review-action-btn employment-review-action-success" data-employment-period-action id="postCorrectivePayrollBtn">Καταχώριση διορθωτικής μισθοδοσίας</button>
                </div>
            </div>
        </div>
        <div id="employmentPeriodControlMessage" class="small text-muted mt-1"></div>
        <div id="employmentPeriodCorrectiveLegend" class="small mt-1 d-none">
            <span class="fw-semibold">Αρχικό οριστικοποιημένο αποτέλεσμα</span>
            <span class="mx-2">·</span>
            <span>Διορθωτική διαφορά</span>
            <span class="mx-2">·</span>
            <span>Διορθωμένο αποτέλεσμα</span>
        </div>
        <div id="employmentPeriodCorrectiveSummary" class="small mt-2 d-none"></div>
    </div>
    <% } else { %>
        <div class="alert alert-warning text-center" role="alert">
            Δεν έχετε δικαίωμα χρήσης του ελέγχου απασχολήσεων.
        </div>
    <% } %>

    <% if (canUseAdvancedEmploymentReview) { %>
    <section id="employmentReviewWorkspace" class="employment-review-workspace">
    <div class="card shadow-sm rounded-4 employment-review-card z-depth-5">
        <div class="card-header text-center">
            <h3 class="mb-0">Έλεγχος Απασχολήσεων</h3>
        </div>

        <div class="card-body review-card-body">
            <div class="review-filters-sticky">
                <div class="row g-1 mb-2" id="reviewFiltersEnterScope">
                    <div class="col-md-2">
                        <label class="form-label">Από Ημερομηνία</label>
                        <input
                            type="date"
                            id="apo_hmeromhnia"
                            class="form-control date-tall move-by-enter"
                            value="<%= dateInputValue(periodRec?.apo) %>"
                        />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Έως Ημερομηνία</label>
                        <input
                            type="date"
                            id="eos_hmeromhnia"
                            class="form-control date-tall move-by-enter"
                            value="<%= dateInputValue(periodRec?.eos) %>"
                        />
                    </div>

                    <div class="col-md-4 employment-review-advanced-branch">
                        <label class="form-label" for="ypokatasthma">Παράρτημα</label>
                        <input
                            type="hidden"
                            id="ypokatasthma_stathera_advanced"
                            value=""
                            readonly
                        />
                        <select
                            id="ypokatasthma"
                            class="tom-dropdown selectpicker-dropdown-normal left-align move-by-enter"
                            aria-label="Παράρτημα"
                            data-api="/api/dropdown/erganh/ypokatasthmata?company=<%= companyInUse || '' %>"
                            data-target-input="ypokatasthma_stathera_advanced"
                            data-preselect="ypokatasthma_stathera_advanced"
                            data-dropdown-direction="down"
                            data-preload-all="true"
                            data-pad-length="4"
                            data-xrhsh-related="false"
                            data-team-related="false"
                            data-company-related="false"
                            data-mhnas-related="false"
                            data-skip-autoload="true"
                            single
                            placeholder="Επιλέξτε παράρτημα">
                        </select>
                        <div id="advancedBranchValidation" class="invalid-feedback d-block d-none">
                            Επιλέξτε συγκεκριμένο παράρτημα.
                        </div>
                    </div>

                    <div class="col-md-4 employment-review-advanced-branch">
                        <label class="form-label" for="reviewEmployee">Εργαζόμενος</label>
                        <input type="hidden" id="kodikos" value="" />
                        <select id="reviewEmployee"
                            class="tom-dropdown selectpicker-dropdown-normal left-align move-by-enter"
                            aria-label="Εργαζόμενος"
                            data-api="/api/dropdown/kinhseis/apasxolhseis/ergazomenoi"
                            data-target-input="kodikos"
                            data-preselect="kodikos"
                            data-dropdown-direction="down"
                            data-xrhsh-related="false"
                            data-team-related="false"
                            data-company-related="false"
                            data-mhnas-related="false"
                            data-skip-autoload="true"
                            single
                            placeholder="Αναζήτηση εργαζομένου">
                        </select>
                    </div>
                </div>

                <div class="employment-review-search-actions">
                    <button type="button" class="btn btn-brown rounded-4" id="searchBtn">
                        <i class="bi bi-search"></i>
                        Αναζήτηση
                    </button>

                    <button type="button" class="btn btn-brown rounded-4 ms-2" id="exportExcelBtn">
                        <i class="bi bi-file-earmark-excel"></i>
                        Εξαγωγή Excel
                    </button>

                    <button type="button" class="btn btn-brown rounded-4 ms-2" id="exportPdfBtn">
                        <i class="bi bi-file-earmark-pdf"></i>
                        Εξαγωγή PDF
                    </button>

                    <button type="button" class="btn btn-brown rounded-4 ms-2" id="exportAuditDossierPdfBtn">
                        <i class="bi bi-folder2-open"></i>
                        Φάκελος Ελέγχου PDF
                    </button>
                </div>
            </div>

            <nav id="employmentReviewWorkflowProgress" class="employment-review-workflow-progress d-none"
                aria-label="Πρόοδος Ελέγχου Απασχολήσεων"></nav>
            <section id="employmentReviewAttentionSummary"
                class="employment-review-attention-summary d-none" aria-live="polite"></section>
            <div id="employmentReviewWorkflowSummary" class="d-none" aria-hidden="true"></div>
            <div class="d-none" aria-hidden="true">
                <button type="button" id="employmentReviewBoundaryContextButton"
                    class="btn btn-sm employment-review-action-btn employment-review-action-secondary employment-review-boundary-context-button d-none">
                    ⓘ Πληροφορίες οριακών εβδομάδων
                </button>
            </div>

            <div class="employment-review-scroll-container">
                <div class="accordion" id="employmentReviewStagesAccordion">
                    <div class="accordion-item" data-workflow-stage="STAGE1">
                        <h2 class="accordion-header" id="employmentReviewStage1Heading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#employmentReviewStage1Collapse" aria-expanded="false"
                                aria-controls="employmentReviewStage1Collapse">
                                <span class="workflow-stage-header" data-workflow-stage-header="STAGE1">ΣΤΑΔΙΟ 1 — Χαρακτηρισμός Αδειών</span>
                            </button>
                        </h2>
                        <div id="employmentReviewStage1Collapse" class="accordion-collapse collapse"
                            data-bs-parent="#employmentReviewStagesAccordion">
                            <div class="accordion-body">
                                <div id="weeklyHrStage1Container" class="employment-review-actionable-summary"></div>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item" data-workflow-stage="STAGE2">
                        <h2 class="accordion-header" id="employmentReviewStage2Heading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#employmentReviewStage2Collapse" aria-expanded="false"
                                aria-controls="employmentReviewStage2Collapse">
                                <span class="workflow-stage-header" data-workflow-stage-header="STAGE2">ΣΤΑΔΙΟ 2 — Μεταφορά Ρεπό</span>
                            </button>
                        </h2>
                        <div id="employmentReviewStage2Collapse" class="accordion-collapse collapse"
                            data-bs-parent="#employmentReviewStagesAccordion">
                            <div class="accordion-body">
                                <div id="policyPreviewGroupsContainer" class="employment-review-actionable-summary"></div>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item" data-workflow-stage="STAGE3">
                        <h2 class="accordion-header" id="employmentReviewStage3Heading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#employmentReviewStage3Collapse" aria-expanded="false"
                                aria-controls="employmentReviewStage3Collapse">
                                <span class="workflow-stage-header" data-workflow-stage-header="STAGE3">ΣΤΑΔΙΟ 3 — Υπόλοιπες Πιθανές Άδειες</span>
                            </button>
                        </h2>
                        <div id="employmentReviewStage3Collapse" class="accordion-collapse collapse"
                            data-bs-parent="#employmentReviewStagesAccordion">
                            <div class="accordion-body">
                                <div id="weeklyHrStage3Container" class="employment-review-actionable-summary"></div>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item" data-workflow-stage="STAGE4">
                        <h2 class="accordion-header" id="employmentReviewStage4Heading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#employmentReviewStage4Collapse" aria-expanded="false"
                                aria-controls="employmentReviewStage4Collapse">
                                <span class="workflow-stage-header" data-workflow-stage-header="STAGE4">ΣΤΑΔΙΟ 4 — Τελικός Εβδομαδιαίος Έλεγχος</span>
                            </button>
                        </h2>
                        <div id="employmentReviewStage4Collapse" class="accordion-collapse collapse"
                            data-bs-parent="#employmentReviewStagesAccordion">
                            <div class="accordion-body p-0">
                <div id="employmentReviewStage4PreviewNotice" class="alert alert-info small py-2 mx-2 mt-2 mb-0 d-none">
                    Προεπισκόπηση — μόνο για ενημέρωση. Ο Τελικός Έλεγχος θα είναι διαθέσιμος μόλις ολοκληρωθεί το προηγούμενο στάδιο.
                </div>
                <div class="table-responsive results-table-wrapper">
                    <table class="table table-bordered table-hover align-middle" id="resultsTable">
                    <colgroup class="employment-review-results-columns">
                        <col class="review-col-date" />
                        <col class="review-col-branch" />
                        <col class="review-col-code" />
                        <col class="review-col-declared" />
                        <col class="review-col-cards" />
                        <col class="review-col-apologistiko" />
                        <col class="review-col-hours" />
                        <col class="review-col-absences" />
                        <col class="review-col-night" />
                        <col class="review-col-holiday" />
                        <col class="review-col-additional" />
                        <col class="review-col-overwork" />
                        <col class="review-col-overtime" />
                    </colgroup>
                    <thead class="table-dark">
                        <tr>
                            <th>Ημ/νία</th>
                            <th>Παράρτημα</th>
                            <th>Κωδικός</th>
                            <!-- <th>Εργαζόμενος</th> -->
                            <th>Προδηλωμένο</th>
                            <th>Κάρτες</th>
                            <th>Απολογιστικό</th>
                            <th>Ώρες</th>
                            <th>Απουσίες</th>
                            <th>Νύχτα</th>
                            <th>Αργία</th>
                            <th>Πρόσθ.</th>
                            <th>Υπερεργ.</th>
                            <th>Υπερωρ.</th>
                        </tr>
                    </thead>

                    <tbody></tbody>
                    </table>
                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <button type="button" id="employmentReviewScrollToTop"
                class="btn btn-toTop employment-review-scroll-to-top"
                aria-label="Επιστροφή στην κορυφή" hidden>
                <i class="bi bi-chevron-double-up" aria-hidden="true"></i>
            </button>
        </div>

        <div class="card-footer">
            <a class="btn btn-secondary rounded-4 employment-review-return-btn" href="/mainapp">
                <i class="bi bi-chevron-double-left"></i>
                Επιστροφή
            </a>
        </div>
    </div>

    <div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="modal-title mb-0">Λεπτομέρειες Απασχόλησης</h5>
                        <span id="detailsLockBadge" class="review-lock-badge d-none">
                            🔒 ΚΛΕΙΔΩΜΕΝΟ
                        </span>
                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                    ></button>
                </div>

                <div class="modal-body">
                    <div id="detailsContainer"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn employment-review-action-btn employment-review-action-secondary" data-bs-dismiss="modal">
                        Κλείσιμο
                    </button>
                </div>
            </div>
        </div>
    </div>



    <div class="modal fade" id="pdfPreviewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Προεπισκόπηση PDF</h5>
                    <div class="d-flex gap-2">

                        <button
                            type="button"
                            class="btn btn-brown rounded-4"
                            id="reviewPdfDownloadBtn"
                            data-no-loader="true">
                            <i class="bi bi-download"></i>
                            Αποθήκευση τοπικά
                        </button>

                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body p-0">
                    <iframe id="reviewPdfFrame" title="Προεπισκόπηση PDF" style="width:100%;height:calc(100vh - 70px);border:0;"></iframe>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="canonicalDecisionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Απόφαση εβδομαδιαίου ελέγχου</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Κλείσιμο"></button>
                </div>
                <div class="modal-body" id="canonicalDecisionContainer">
                    <div class="text-muted">Φόρτωση τρέχουσας κατάστασης…</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn employment-review-action-btn employment-review-action-secondary" data-bs-dismiss="modal">Κλείσιμο</button>
                </div>
            </div>
        </div>
    </div>

    <div
        class="modal fade employment-review-stage2-bulk-preview-modal"
        id="weeklyHrStage2BulkPreviewModal"
        tabindex="-1"
        aria-labelledby="weeklyHrStage2BulkPreviewModalLabel"
        aria-hidden="true"
    >
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header align-items-start">
                    <div class="weekly-hr-stage2-preview-heading flex-grow-1">
                        <h5 class="modal-title" id="weeklyHrStage2BulkPreviewModalLabel">
                            Προεπισκόπηση μαζικής ενημέρωσης ρεπό
                        </h5>
                        <div class="alert alert-info py-2 px-3 mt-2 mb-2" role="status">
                            Δεν έχει γίνει ακόμη καμία αλλαγή.
                        </div>
                        <div class="weekly-hr-stage2-preview-summary" aria-label="Σύνοψη προεπισκόπησης">
                            <span><strong id="weeklyHrStage2PreviewCaseCount">0</strong> Περιπτώσεις</span>
                            <span><strong id="weeklyHrStage2PreviewEmployeeCount">0</strong> Εργαζόμενοι</span>
                            <span><strong id="weeklyHrStage2PreviewWeekCount">0</strong> Εβδομάδες</span>
                            <span><strong id="weeklyHrStage2PreviewDayCount">0</strong> Ημερήσιες αλλαγές</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close ms-3" data-bs-dismiss="modal" aria-label="Κλείσιμο"></button>
                </div>
                <div class="modal-body" id="weeklyHrStage2BulkPreviewBody"></div>
                <div class="modal-footer weekly-hr-stage2-preview-footer">
                    <div class="weekly-hr-stage2-preview-safety">
                        Πριν από κάθε αλλαγή, το σύστημα θα ελέγξει ξανά ότι τα στοιχεία δεν έχουν μεταβληθεί.
                        Αν κάποια περίπτωση έχει αλλάξει, δεν θα ενημερωθεί και θα εμφανιστεί για νέο έλεγχο.
                    </div>
                    <div class="weekly-hr-stage2-preview-controls">
                        <div class="weekly-hr-stage2-preview-pagination" aria-label="Σελιδοποίηση προεπισκόπησης">
                            <button type="button" id="weeklyHrStage2PreviewPrevious"
                                class="btn btn-sm employment-review-action-btn employment-review-action-secondary nowrap">
                                ‹ Προηγούμενη
                            </button>
                            <span id="weeklyHrStage2PreviewPageLabel" aria-live="polite">Σελίδα 1 από 1</span>
                            <button type="button" id="weeklyHrStage2PreviewNext"
                                class="btn btn-sm employment-review-action-btn employment-review-action-secondary nowrap">
                                Επόμενη ›
                            </button>
                        </div>
                        <div class="weekly-hr-stage2-preview-reason">
                            <label for="weeklyHrStage2PreviewReason" class="form-label mb-1">Αιτιολογία</label>
                            <textarea id="weeklyHrStage2PreviewReason" class="form-control form-control-sm" rows="2" required></textarea>
                            <div class="invalid-feedback">Η αιτιολογία είναι υποχρεωτική.</div>
                        </div>
                        <div class="weekly-hr-stage2-preview-actions">
                            <button type="button" class="btn employment-review-action-btn employment-review-action-secondary nowrap"
                                data-bs-dismiss="modal">Ακύρωση</button>
                            <button type="button" id="weeklyHrStage2PreviewApply"
                                class="btn employment-review-action-btn employment-review-action-success nowrap">
                                Εφαρμογή ενημερώσεων
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </section>
    <% } %>
    <input
        type="hidden"
        id="canReviewEdit"
        value="<%= ['A', 'S', 'HR'].includes(normalizedUserRole) ? '1' : '0' %>"
    />
    <input
        type="hidden"
        id="canRecordRepoTransferDecision"
        value="<%= canRecordRepoTransferDecision ? '1' : '0' %>"
    />
    <input
        type="hidden"
        id="canManageReusablePolicyApproval"
        value="<%= canManageReusablePolicyApproval ? '1' : '0' %>"
    />
    <input
        type="hidden"
        id="canApplyRepoTransferDecision"
        value="<%= canApplyRepoTransferDecision ? '1' : '0' %>"
    />
    <input
        type="hidden"
        id="canUseAdvancedEmploymentReview"
        value="<%= canUseAdvancedEmploymentReview ? '1' : '0' %>"
    />

    <% if (canRecordRepoTransferDecision) { %>
        <script type="module" src="<%= script('ergazomenoi/programmata/initYpokatasthmataDropdowns.js') %>"></script>
    <% } %>
    <script src="<%= script('ergazomenoi/programmata/elegxosApasxolhseonPeriodoy.orphanQualityCheck') %>"></script>
    <script src="<%= script('ergazomenoi/programmata/elegxosApasxolhseonPeriodoy') %>"></script>
</div>
