<br> <br> <br>
<form class="formRadius final-wto-submitted-document-form" id="finalWtoSubmittedDocumentForm">
    <div class="card d-flex flex-column z-depth-5 w-60 margin-left-percent-20 final-wto-submitted-document-card">
        <div class="card-header p-0 height-rem-3_5">
            <label class="headers-content">Εκτύπωση Οριστικού Απολογιστικού Πίνακα</label>
        </div>
        <div class="card-body flex-grow-1 bg-white final-wto-submitted-document-body">
            <% const dateValue = (value) => value ? new Date(value).toISOString().slice(0, 10) : ''; %>
            <br>
            <div class="row form-group g-3 align-items-center mb-3">
                <div class="col-2 left-align">
                    <label for="ypokatasthma" class="col-form-label label-font-size-smaller field-required">Παράρτημα</label>
                </div>
                <input type="hidden" id="ypokatasthma_stathera_advanced" value="" readonly>
                <div class="col-9-5 mt-2">
                    <select id="ypokatasthma" class="tom-dropdown selectpicker-dropdown-normal left-align"
                        aria-label="Παράρτημα"
                        data-api="/api/dropdown/erganh/ypokatasthmata?company=<%= companyId || '' %>"
                        data-target-input="ypokatasthma_stathera_advanced"
                        data-preselect="ypokatasthma_stathera_advanced"
                        data-preload-all="true" data-pad-length="4"
                        data-xrhsh-related="false" data-team-related="false"
                        data-company-related="false" data-mhnas-related="false"
                        single placeholder="Επιλέξτε παράρτημα"></select>
                </div>
            </div>
            <div class="row form-group g-3 align-items-center mb-4"></div>
            <div class="row form-group g-3 align-items-center mb-3">
                <div class="col-2 left-align"><label for="apo_hmeromhnia" class="col-form-label label-font-size-smaller">Από Ημερομηνία</label></div>
                <div class="col-2-5"><input type="date" id="apo_hmeromhnia" class="date-control" value="<%= dateValue(periodRec && periodRec.apo) %>" required></div>
            </div>
            <div class="row form-group g-3 align-items-center mb-4"></div>
            <div class="row form-group g-3 align-items-center mb-3">
                <div class="col-2 left-align"><label for="eos_hmeromhnia" class="col-form-label label-font-size-smaller">Έως Ημερομηνία</label></div>
                <div class="col-2-5"><input type="date" id="eos_hmeromhnia" class="date-control" value="<%= dateValue(periodRec && periodRec.eos) %>" required></div>
            </div>
            <div id="finalWtoSubmittedDocumentMetadata" class="alert alert-success d-none mt-4" role="status">
                <strong>Οριστική υποβολή WTODailyA</strong><br>
                Πρωτόκολλο: <span id="finalWtoSubmittedProtocol"></span><br>
                Ημερομηνία Υποβολής: <span id="finalWtoSubmittedDate"></span><br>
                Κατάσταση: <span id="finalWtoSubmittedStatus"></span>
            </div>
        </div>
        <div class="card-footer">
            <div class="d-inline-block d-flex cardFooter01">
                <button type="button"
                    class="btn btn-brown rounded-4 mt-2 w-30 buttons-content <% if (!userPrivileges.admin && !userPrivileges.export) { %>disabled-link<% } %>"
                    id="openFinalWtoSubmittedDocumentButton" <% if (!userPrivileges.admin && !userPrivileges.export) { %>disabled aria-disabled="true"<% } %>>
                    <i class="bi bi-file-earmark-pdf"></i> Άνοιγμα Οριστικού PDF
                </button>
                <a class="btn btn-brown buttons-content rounded-4 mt-2 w-20" href="/mainapp">
                    <i class="bi bi-chevron-double-left"></i> Επιστροφή
                </a>
            </div>
        </div>
    </div>
</form>
<script type="module" src="<%= script('ergazomenoi/programmata/initYpokatasthmataDropdowns.js') %>"></script>
<script src="<%= script('ergazomenoi/genika/erganiRestSubmissionUi.js') %>"></script>
<script src="<%= script('ergazomenoi/programmata/ektyposhOristikouApologistikouPinaka.js') %>"></script>
