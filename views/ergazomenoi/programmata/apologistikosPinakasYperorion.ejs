<br><br>
<style nonce="<%= nonce %>">
    #wtoOvertimeSummary {
        overflow-x: auto;
        white-space: nowrap;
    }
    #wtoOvertimeStatus {
        white-space: pre-line;
    }
    .wto-overtime-status-attention {
        background-color: #fff8db !important;
        border: 1px solid #e5cf78 !important;
        cursor: help;
    }
    .wto-overtime-tooltip .tooltip-inner {
        max-width: 28rem;
        white-space: normal;
    }
</style>
<section class="container-fluid px-4" id="wtoOvertimeApp"
    data-company-name="<%= companyName %>"
    data-can-export="<%= userPrivileges.admin === true || userPrivileges.export === true %>">
    <form id="wtoOvertimeForm">
    <div id="wtoOvertimeCard" class="card d-flex flex-column shadow-sm z-depth-5 overflow-hidden">
        <div class="card-header p-0 height-rem-3_5">
            <label class="headers-content">Απολογιστικός Πίνακας Υπερωριών</label>
        </div>
        <div id="wtoOvertimeCardBody" class="card-body d-flex flex-column flex-grow-1"
            style="min-height: 0; overflow: hidden;">
            <input type="hidden" id="wtoOvertimeCsrf" value="<%= csrfToken %>">
            <div class="row g-3 align-items-end flex-shrink-0">
                <div class="col-lg-4">
                    <label class="form-label field-required" for="wtoOvertimeBranch">Υποκατάστημα</label>
                    <select class="form-select" id="wtoOvertimeBranch" required>
                        <option value="">Επιλέξτε υποκατάστημα</option>
                        <% for (const branch of branches || []) { %>
                            <option value="<%= branch.kodikos %>"><%= branch.kodikos %> — <%= branch.perigrafh || '' %></option>
                        <% } %>
                    </select>
                </div>
                <div class="col-lg-3">
                    <label class="form-label field-required" for="wtoOvertimeFrom">Από ημερομηνία</label>
                    <input class="date-control" type="date" id="wtoOvertimeFrom"
                        value="<%= periodRec && periodRec.apo ? new Date(periodRec.apo).toISOString().slice(0, 10) : '' %>" required>
                </div>
                <div class="col-lg-3">
                    <label class="form-label field-required" for="wtoOvertimeTo">Έως ημερομηνία</label>
                    <input class="date-control" type="date" id="wtoOvertimeTo"
                        value="<%= periodRec && periodRec.eos ? new Date(periodRec.eos).toISOString().slice(0, 10) : '' %>" required>
                </div>
                <div class="col-lg-2">
                    <button class="btn btn-brown w-100" type="button" id="wtoOvertimePreviewButton">
                        <i class="bi bi-search"></i> Προεπισκόπηση
                    </button>
                </div>
            </div>

            <div class="alert alert-secondary mt-3 mb-0 flex-shrink-0" id="wtoOvertimeStatus" role="status">
                Επιλέξτε υποκατάστημα και ημερομηνίες για προεπισκόπηση.
            </div>

            <div class="d-flex flex-nowrap align-items-center gap-3 border rounded px-3 py-2 mt-2 flex-shrink-0"
                id="wtoOvertimeSummary" hidden>
                <span>Εργαζόμενοι: <strong id="wtoOvertimeEmployeeCount">0</strong></span>
                <span aria-hidden="true">|</span>
                <span>Ημέρες: <strong id="wtoOvertimeDayCount">0</strong></span>
                <span aria-hidden="true">|</span>
                <span>Σύνολο Υποβαλλόμενων Υπερωριών: <strong id="wtoOvertimeSubmittedTotal">0:00</strong></span>
            </div>

            <div id="wtoOvertimeResultsScroll" class="table-responsive mt-3"
                style="flex: 1 1 12rem; min-height: 5rem; max-height: 19rem; overflow-y: auto; overflow-x: auto;">
                <table class="table table-sm table-striped table-bordered align-middle text-nowrap">
                    <thead class="position-sticky top-0 bg-white"><tr>
                        <th>Κωδικός</th><th>ΑΦΜ</th><th>Εργαζόμενος</th><th>Ημερομηνία</th>
                        <th>Προς υποβολή</th><th>Τύπος</th><th>Από</th><th>Έως</th><th>Κατάσταση</th>
                    </tr></thead>
                    <tbody id="wtoOvertimeRows"><tr><td colspan="9" class="text-center text-muted">Δεν υπάρχει προεπισκόπηση.</td></tr></tbody>
                </table>
            </div>

        </div>
        <div class="card-footer mt-auto d-flex gap-2 flex-wrap">
            <button class="btn btn-danger" type="button" id="wtoOvertimeSubmitButton" disabled>
                <i class="bi bi-send-check"></i> Τελική Υποβολή WTOOvA στο ΕΡΓΑΝΗ
            </button>
            <a class="btn btn-brown" href="/mainapp"><i class="bi bi-chevron-double-left"></i> Επιστροφή</a>
        </div>
    </div>
    </form>
</section>

<script src="<%= script('ergazomenoi/genika/erganiRestSubmissionUi') %>"></script>
<script nonce="<%= nonce %>" src="<%= script('ergazomenoi/programmata/wtoOvertime.js') %>"></script>
