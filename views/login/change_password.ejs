

<!-- ✅ FLASH MESSAGES -->
<%- include('../partials/flash') %>



<div class="password-page">
    <form action="/login/change_password/changepassword" method="POST">

        <%- include('../partials/_csrfField') %>

        <div class="card z-depth-5">
            <div class="card-header bg-header text-center"><h4 class="password-title">Αλλαγή Password</h4></div>

            <div class="card-body">
<!-- ✅ DIRECT ERROR (NEW - will add here) -->
<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger">
        <strong>Σφάλμα:</strong> <%= error %>
    </div>
<% } %>
                <div class="password-fields">
<div class="password-field">
                    <div class="password-label">
                        <label for="email" class="col-form-label field-required">
                            @Email
                        </label>
                    </div>
                    <div class="password-input">
                        <input
                            type="email"
                            name="email"
                            id="email"
                            class="form-control"
                            required
                        />
                    </div>
                </div>

                <div class="password-field">
                    <div class="password-label">
                        <label for="old_password" class="col-form-label field-required">
                            Τρέχον Password
                        </label>
                    </div>
                    <div class="password-input">
                        <input
                            type="password"
                            name="old_password"
                            id="old_password"
                            class="form-control"
                            required
                        />
                    </div>
                </div>

                <div class="password-field">
                    <div class="password-label">
                        <label for="password" class="col-form-label field-required">
                            Νέο Password
                        </label>
                    </div>
                    <div class="password-input">
                        <input
                            type="password"
                            name="password"
                            id="password"
                            class="form-control"
                            minlength="8"
                            placeholder="8 χαρακτήρες minimum"
                            required
                        />
                    </div>
                </div>

                <div class="password-field">
                    <div class="password-label">
                        <label for="password_confirmation" class="col-form-label field-required">
                            Επιβεβαίωση Password
                        </label>
                    </div>
                    <div class="password-input">
                        <input
                            type="password"
                            name="password_confirmation"
                            id="password_confirmation"
                            class="form-control"
                            minlength="8"
                            placeholder="8 χαρακτήρες minimum"
                            required
                        />
                    </div>
                </div>
                </div>
            </div>

            <div class="card-footer">
                <div
                    class="password-actions">

                    <button type="submit" class="btn btn-brown"><i class="bi bi-arrow-left-right"></i> Αλλαγή</button>
                    <a class="btn btn-brown" href="/login"><i class="bi bi-x-octagon"></i> Ακύρωση</a>
                </div>
            </div>
        </div>
    </form>
</div>
