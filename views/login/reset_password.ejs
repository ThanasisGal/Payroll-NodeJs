

<%- include('../partials/flash') %>

<div class="password-page">
  <form action="/login/send-reset-password-email" method="POST">

    <%- include('../partials/_csrfField') %>
  <div class="card z-depth-5">
      <div class="card-header bg-header text-center"><h4 class="password-title">Επαναφορά κωδικού πρόσβασης</h4></div>
      <div class="card-body">
        <div class="password-fields">
<div class="password-field">
          <div class="password-label">
            <label for="email" class="col-form-label field-required"
              >e-mail</label
            >
          </div>
          <div class="password-input">
            <input
              type="text"
              name="email"
              id="email"
              class="form-control"
              required
            />
          </div>
        </div>
                </div>

      </div>

      <div class="card-footer">
        <div
          class="password-actions">
          <button type="submit" class="btn btn-brown"><i class="bi bi-send"></i> Αποστολή
          </button>
          <a class="btn btn-brown" href="/"
            ><i class="bi bi-x-octagon"></i> Ακύρωση</a
          >
        </div>
      </div>
    </div>
  </form>
</div>
