<div class="logout-confirmation">
    <div class="card z-depth-5">
        <!-- ✅ Card Header -->
        <div class="card-header">
            <label class="w-100 text-center logout-title">Αποσύνδεση & Έξοδος από την Εφαρμογή</label>
        </div>

        <!-- ✅ Card Body -->
        <div class="card-body">
            <div class="logout-content text-center">
                <div class="text-center">
                    <i class="bi bi-bell-fill corange bi-logout-swing logout-bell"></i>
                    <p class="logout-message">Είστε σίγουρος/η ότι θέλετε να κλείσετε την εφαρμογή;</p>
                </div>
            </div>
        </div>

        <!-- ✅ Card Footer με σωστό spacing -->
        <div class="card-footer cardFooter">
            <div class="d-flex justify-content-center logout-actions">
                <!-- ✅ POST form με CSRF -->
                <form method="POST" action="/logout/userLogout" class="d-inline-block">
                    <%- include('../partials/_csrfField') %>
                    <button type="submit" class="btn btn-brown">
                        <i class="bi bi-box-arrow-right"></i> Έξοδος
                    </button>
                </form>

                <!-- ✅ Επιστροφή link -->
                <a class="btn btn-brown buttons-content" href="/">
                    <i class="bi bi-chevron-double-left"></i> Επιστροφή
                </a>
            </div>
        </div>
    </div>
</div>