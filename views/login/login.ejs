<%- include('../partials/flash') %>
<div class="login-confirmation">
    <form action="/login/userLogin" method="POST">

        <%- include('../partials/_csrfField') %>

        <div class="card z-depth-5">
            <div class="card-header">
                <label class="login-title w-100 text-center">Σύνδεση & Είσοδος στην Εφαρμογή</label>
            </div>
            <div class="card-body">
                <div class="login-fields">
                <div class="login-field">
                    <div class="login-label">
                        <label for="email" class="col-form-label field-required">e-mail</label>
                    </div>
                    <div class="login-input">
                        <input
                            type="text"
                            name="email"
                            id="email"
                            class="form-control"
                            required
                        />
                    </div>
                </div>

                <div class="login-field">
                    <div class="login-label">
                        <label for="password" class="col-form-label field-required">Password</label>
                    </div>
                    <div class="login-input">
                        <input
                            type="password"
                            name="password"
                            id="password"
                            class="form-control"
                            autocomplete="off"
                            required
                        />
                    </div>
                </div>

                </div>

                <div class="login-links text-center" tabindex="-1">
                    <a class="small text-muted" href="/login/verify-email"><i class="bi bi-pencil-square"></i> Εγγραφείτε</a>

                    <a class="small text-muted" href="/reset_password"><i class="bi bi-patch-question"></i> Ξεχάσατε το password; </a>

                    <a class="small text-muted" href="/login/change_password"><i class="bi bi-key"></i> Αλλαγή Password</a>
                </div>
            </div>

            <div class="card-footer" >
                <div class="login-actions">
                    <button type="submit" class="btn btn-brown buttons-content"><i class="buttons-content bi bi-box-arrow-in-right"></i> Είσοδος
                    </button>

                    <% if (typeof userName !== 'undefined' && userName.length > 0) { %>
                        <a class="btn btn-brown buttons-content" href="/"
                        ><i class="buttons-content bi bi-chevron-double-left"></i> Επιστροφή</a>
                    <% } else { %>
                        <a class="btn btn-brown buttons-content" href="/"
                        ><i class="buttons-content bi bi-x-octagon"></i> Ακύρωση</a>
                    <% } %>
                </div>
            </div>
        </div>
    </form>
</div>
