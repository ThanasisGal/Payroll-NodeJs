
<%- include('../partials/flash') %>

<div class="account-confirmation">
    <form id="verifyForm" action="/login/verify-email" method="POST">
        <%- include('../partials/_csrfField') %>

        <div class="card z-depth-5">
            <div class="card-header bg-header text-center"><h4 class="account-title">Επαλήθευση Email</h4></div>

            <div class="card-body">
                <div class="account-fields">
<div class="account-field">
                    <div class="account-label">
                        <label for="email" class="col-form-label field-required">
                            e-mail
                        </label>
                    </div>
                    <div class="account-input">
                        <input
                            type="text"
                            name="email"
                            id="email"
                            class="form-control"
                            required
                        />
                    </div>
                </div>
                </div>
            </div>

            <div class="card-footer">
                <div class="account-actions">
                    <button type="submit" id="verifyBtn" class="btn btn-brown"><i class="bi bi-send"></i> Αποστολή</button>
                    <a class="btn btn-brown" href="/"><i class="bi bi-x-octagon"></i> Ακύρωση</a>
                </div>
            </div>
        </div>
    </form>
</div>

<script nonce="<%= nonce %>">
    (function () {
        const form = document.getElementById('verifyForm');
        const btn  = document.getElementById('verifyBtn');
        form.addEventListener('submit', function () {
        if (btn) { btn.disabled = true; btn.classList.add('disabled'); }
        });
    })();
</script>
